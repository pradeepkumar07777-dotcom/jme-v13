PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ============================================================
# GOOGLE WORKSPACE — MODEL A
# One official JME Google account controls Meet/Classroom/Drive/YouTube.
# Students continue using their JME login; they do not need Google OAuth.
# ============================================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# For local testing:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
# For production, replace with your HTTPS domain:
# GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/api/google/oauth/callback

# Optional legacy JaaS fallback. Leave blank if you want Google-first Model A.
LIVE_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY=
JAAS_WEBHOOK_SECRET=
JAAS_DOMAIN=8x8.vc

# Optional legacy R2 recording fallback. Google Drive is used when Model A is connected.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_RECORDINGS_PREFIX=recordings
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# JME UPI (manual/intent payment option)
JME_UPI_ID=8168667655@ptyes
JME_UPI_NAME=Judiciary Made Easy

# Cloudflare R2 / S3-compatible object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=

# Optional Bunny Stream / CDN integration
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
